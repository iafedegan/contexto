# CONtexto Ganadero — variables de entorno
#
# En local no hace falta ninguna: sin DATABASE_URL la app arranca con PGlite
# embebido y se siembra sola. Este archivo documenta lo que SÍ hace falta al
# desplegar (Vercel u otro hosting con sistema de archivos de solo lectura),
# donde PGlite no es viable porque necesita escribir en disco.

# --- OBLIGATORIAS EN PRODUCCIÓN -------------------------------------------

# Postgres gestionado (Supabase). Con el pooler para serverless: una función
# por petición agotaría las conexiones directas.
DATABASE_URL=postgresql://postgres:CLAVE@db.PROYECTO.supabase.co:5432/postgres
DATABASE_URL_POOLED=postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres

# Firma de las sesiones del panel. Genera una propia:
#   openssl rand -base64 32
# Si cambia, se invalidan las sesiones Y las claves de API guardadas cifradas.
AUTH_SECRET=

# URL pública del sitio: canónicas, sitemaps, Open Graph y enlaces de
# vista previa firmados dependen de ella.
NEXT_PUBLIC_SITE_URL=https://contextoganadero.com

# --- OPCIONALES ------------------------------------------------------------

# Nombre por defecto antes de que un administrador lo cambie en el panel.
NEXT_PUBLIC_SITE_NAME=CONtexto Ganadero

# Modelo de IA. Sin clave, el asistente responde solo con fuentes recuperadas
# y la redacción asistida entrega un esqueleto, sin inventar hechos.
# También se pueden guardar cifradas desde /panel/configuracion.
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=            # solo para embeddings de la búsqueda semántica

# Analítica y auditoría (configurables también desde el panel).
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
PAGESPEED_API_KEY=

# Notificaciones push. Genera el par con:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contexto@fedegan.org.co

# Archivo histórico (migración desde el sistema origen).
ARCHIVE_API_BASE_URL=
ARCHIVE_API_KEY=

# Secretos de los endpoints internos (cron de publicación programada y
# revalidación bajo demanda).
CRON_SECRET=
REVALIDATE_SECRET=

# Topes de gasto del asistente.
ASSISTANT_MONTHLY_BUDGET_USD=150
ASSISTANT_SESSION_QUERY_LIMIT=15

# --- SOLO DESARROLLO -------------------------------------------------------

# KEEP_LOCAL_DB=1 conserva la base local entre arranques; por defecto se
# recrea en cada `npm run dev` para tener una demo determinista.
# KEEP_LOCAL_DB=1

# --- Verificación humana (Cloudflare Turnstile) -------------------------------
# Gratis en https://dash.cloudflare.com → Turnstile → Add site. Sin estas dos
# claves la verificación se omite (siguen los límites de intentos y el campo
# trampa). Se usa en el login del panel y en los formularios públicos.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
