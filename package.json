{
  "name": "contexto-ganadero",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/dev-setup.ts",
    "dev": "next dev",
    "build": "next build",
    "build:local": "PGLITE_DATA_DIR=memory:// next build",
    "start": "next start",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "db:local:reset": "rm -rf .pglite && tsx scripts/dev-setup.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:extras:pre": "tsx scripts/run-sql.ts drizzle/manual/00_pre_extensions.sql",
    "db:extras:post": "tsx scripts/run-sql.ts drizzle/manual/99_post_indexes.sql",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:extras:pre && npm run db:generate && npm run db:migrate && npm run db:extras:post && npm run db:seed"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.60",
